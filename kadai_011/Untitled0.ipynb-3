      "source": [
        "array = [\"水\",\"金\",\"地\",\"火\",\"木\",\"土\",\"天\",\"海\",\"冥\"]\n",
        "\n",
        "for planet in array:\n",
        "      print(planet)\n",
        "i = 0\n",
        "\n",
        "while i < 9:\n",
        "    print(array[i])\n",
        "    i = i + 1"
      ],
